{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hammouda93/football-tracking/docs/gsr-contract-v1.schema.json",
  "title": "Football Tracking GSR result v1",
  "oneOf": [
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/frame"
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["type", "schema", "engine", "engine_revision", "fps"],
      "properties": {
        "type": {"const": "metadata"},
        "schema": {"const": "football-tracking.gsr/v1"},
        "engine": {"enum": ["tracklab", "winner2025", "external"]},
        "engine_revision": {"type": "string", "minLength": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "frame": {
      "type": "object",
      "required": ["type", "timestamp_ms", "width", "height", "objects"],
      "properties": {
        "type": {"const": "frame"},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "field_score": {"type": "number", "minimum": 0, "maximum": 1},
        "scene_cut": {"type": "boolean"},
        "replay_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/object"}
        }
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "required": ["track_id", "role", "bbox_xyxy", "confidence"],
      "properties": {
        "track_id": {"type": ["string", "integer"]},
        "role": {"enum": ["player", "goalkeeper", "referee"]},
        "bbox_xyxy": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "team_cluster": {"enum": ["A", "B", 0, 1, null]},
        "shirt_number": {"type": ["integer", "null"], "minimum": 0, "maximum": 99},
        "pitch_xy": {
          "type": ["array", "null"],
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true
    }
  }
}
