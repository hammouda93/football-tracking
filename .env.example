DJANGO_SECRET_KEY=change-me-locally
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Africa/Tunis

# The UI queues work; the worker processes one match at a time.
ANALYSIS_BACKEND=yolo
# Suivi des athlètes : legacy conserve le moteur actuel. TrackLab et le profil
# Winner s'exécutent dans un environnement externe via le contrat GSR v1.
ANALYSIS_ATHLETE_ENGINE=legacy
ANALYSIS_SAMPLE_SECONDS=1.0
ANALYSIS_QUALITY_MAX_SAMPLES=360
ANALYSIS_TRACKING_FPS=12.5
# Le profil main_py reproduit une image sur deux d'une source 25 FPS.
ANALYSIS_MIN_YOLO_TRACKING_FPS=12.5
ANALYSIS_DEVICE=cpu
# Fenetre OpenCV fluide dans le worker Windows (ESC annule le test).
ANALYSIS_LIVE_WINDOW=1

# Profil natif Windows : détection football, BoT-SORT avec compensation caméra,
# dédoublonnage, liaison de fragments et équipes apprises sur les tracklets.
YOLO_PROFILE=native_gsr
YOLO_MODEL_PATH=models/football-players.pt
YOLO_CONFIDENCE=0.18
# Le petit ballon utilise un seuil séparé et une sélection temporelle.
YOLO_BALL_CONFIDENCE=0.12
# Récupération multi-échelle uniquement quand le plein cadre perd le petit ballon.
YOLO_BALL_TILED_RECOVERY=1
YOLO_BALL_RECOVERY_INTERVAL_FRAMES=12
YOLO_BALL_RECOVERY_IMAGE_SIZE=960
YOLO_BALL_RECOVERY_OVERLAP=0.15
YOLO_IMAGE_SIZE=1280
YOLO_TRACKER=botsort
# Les détections faibles récupèrent une piste sans créer seules une identité fiable.
YOLO_TRACK_LOW_CONFIDENCE=0.05
YOLO_NEW_TRACK_CONFIDENCE=0.20
YOLO_TRACK_MATCH_THRESHOLD=0.80
YOLO_TRACK_BUFFER_SECONDS=4.8
# Profil du modèle football historique : 0=ballon, 2=joueur, 3=arbitre.
# Laissez une valeur vide quand la classe n'existe pas dans vos poids.
YOLO_PLAYER_CLASS_IDS=2
YOLO_GOALKEEPER_CLASS_IDS=1
YOLO_REFEREE_CLASS_IDS=3
YOLO_BALL_CLASS_IDS=0

# OSNet/Torchreid ou embedding ONNX. Le script Windows installe OSNet x0.25.
NATIVE_GSR_REID_BACKEND=auto
NATIVE_GSR_REID_MODEL_NAME=osnet_x0_25
NATIVE_GSR_REID_MODEL_PATH=
NATIVE_GSR_MAX_GAP_SECONDS=3.0
NATIVE_GSR_GLOBAL_MAX_GAP_SECONDS=7200.0

# Numéro : EasyOCR est une base native ; un classifieur football ONNX 0..99
# peut être indiqué pour une meilleure précision. Les lectures sont votées par piste.
NATIVE_GSR_JERSEY_ENGINE=auto
NATIVE_GSR_JERSEY_MODEL_PATH=
NATIVE_GSR_JERSEY_DEVICE=cpu
NATIVE_GSR_JERSEY_INTERVAL_FRAMES=12
NATIVE_GSR_JERSEY_MINIMUM_BOX_HEIGHT=72
NATIVE_GSR_JERSEY_MAX_CROPS_PER_FRAME=4

# Terrain : modèle ONNX et schéma sémantique correspondant, exactement 97 points.
# Sans ces deux fichiers, aucune fausse position métrique n'est inventée.
NATIVE_GSR_PITCH_MODEL_PATH=
NATIVE_GSR_PITCH_SCHEMA_PATH=
NATIVE_GSR_PITCH_CONFIDENCE=0.20
NATIVE_GSR_PITCH_INTERVAL_FRAMES=10
NATIVE_GSR_PITCH_HOLD_FRAMES=20
NATIVE_GSR_PITCH_EXPECTED_LANDMARKS=97

# En mode strict, Re-ID, OCR, roster numéroté et terrain doivent être prêts.
NATIVE_GSR_STRICT_VALIDATION=1
# Activez après import d'un CSV annoté pour rendre la mesure humaine obligatoire.
NATIVE_GSR_REQUIRE_GROUND_TRUTH=0

# Passerelle GSR externe. Exemple WSL une fois le sidecar installé :
# GSR_RUNNER_COMMAND_JSON=["wsl.exe","bash","/opt/football-gsr/run.sh"]
GSR_RUNNER_COMMAND_JSON=[]
# Pour importer un résultat déjà calculé sans relancer le moteur :
GSR_PRECOMPUTED_RESULT=
GSR_TIMEOUT_SECONDS=43200
GSR_FRAME_TOLERANCE_MS=120
# Cadence du moteur athlètes externe ; le ballon peut rester analysé plus vite.
GSR_TRACKING_FPS=5.0
# sn-gamestate et Winner 2025 ne suivent pas le ballon : on garde le détecteur local.
GSR_BALL_BACKEND=yolo

# Optional FFmpeg overrides. Leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
